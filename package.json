{
  "name": "@langfuse/opencode-observability-plugin",
  "version": "0.2.0",
  "description": "OpenCode plugin that sends session telemetry to Langfuse.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "author": "Langfuse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/opencode-observability-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/langfuse/opencode-observability-plugin/issues"
  },
  "homepage": "https://github.com/langfuse/opencode-observability-plugin#readme",
  "keywords": [
    "langfuse",
    "opencode",
    "plugin",
    "observability",
    "opentelemetry"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --strict --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "lint": "eslint .",
    "test:integration": "pnpm run build && tsc --noEmit -p tsconfig.test.json && vitest run test/integration"
  },
  "dependencies": {
    "@langfuse/otel": "^5.10.1",
    "@opencode-ai/plugin": "^1.15.13",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "effect": "^3.22.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.1",
    "knip": "^6.32.2",
    "prettier": "^3.8.3",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.6"
  }
}
