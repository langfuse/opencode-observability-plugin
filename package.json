{
  "name": "@langfuse/opencode-observability-plugin",
  "version": "0.7.0",
  "description": "OpenCode plugin that sends session telemetry to Langfuse.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v1": {
      "types": "./dist/v1.d.ts",
      "import": "./dist/v1/index.js"
    },
    "./v2": {
      "types": "./dist/v2.d.ts",
      "import": "./dist/v2/index.js"
    }
  },
  "type": "module",
  "author": "Langfuse",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/langfuse/opencode-observability-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/langfuse/opencode-observability-plugin/issues"
  },
  "homepage": "https://github.com/langfuse/opencode-observability-plugin#readme",
  "keywords": [
    "langfuse",
    "opencode",
    "plugin",
    "observability",
    "opentelemetry"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --strict --treat-config-hints-as-errors --treat-tag-hints-as-errors",
    "lint": "eslint .",
    "test:integration": "pnpm run build && tsc --noEmit -p tsconfig.test.json && vitest run test/integration"
  },
  "knip": {
    "ignore": [
      "dist/**"
    ],
    "ignoreDependencies": [
      "@langfuse/otel!",
      "@opentelemetry/api!",
      "@opentelemetry/context-async-hooks!",
      "@opentelemetry/core!",
      "@opentelemetry/resources!",
      "@opentelemetry/sdk-trace-node!",
      "effect!"
    ]
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode/plugin": "^2.0.4"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langfuse/otel": "^6.0.1",
    "@opencode-ai/plugin": "^1.18.29",
    "@opencode/plugin": "^2.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/node": "^26.1.2",
    "effect": "^4.0.6",
    "eslint": "^10.8.1",
    "knip": "^6.32.2",
    "prettier": "^3.8.3",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.6"
  }
}
